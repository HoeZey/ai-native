{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "changelog-path": "CHANGELOG.md",
      "exclude-paths": [
        "context",
        ".cursor/skills"
      ],
      "extra-files": [
        {
          "type": "generic",
          "path": "skills/ai-native-init/scripts/profile.py"
        },
        {
          "type": "json",
          "path": "context/.ai-native.yml",
          "jsonpath": "$.pack"
        }
      ]
    }
  }
}